-				&kovaplus->profile_settings[i], i);
-		if (retval)
-			return retval;
-
-		msleep(wait);
-		retval = kovaplus_get_profile_buttons(usb_dev,
-				&kovaplus->profile_buttons[i], i);
-		if (retval)
-			return retval;
-	}
