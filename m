 	entry->min_range =3D lg4ff_devices[i].min_range;
 	entry->max_range =3D lg4ff_devices[i].max_range;
 	entry->set_range =3D lg4ff_devices[i].set_range;
@@ -601,6 +653,8 @@ out:
