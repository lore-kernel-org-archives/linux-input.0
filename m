From: Paul Walmsley <paul@booyaka.com>

Convert the existing fixed-length hid_blacklist array to a list,
initialized at module load-time.  Add a idProductMask field to support
quirks which match against multiple USB product IDs from the same
vendor.

Signed-off-by: Paul Walmsley <paul@booyaka.com>

---
  dev/drivers/usb/input/hid-core.c |  455 ++++++++++++++++++++++++---------------
  1 file changed, 284 insertions(+), 171 deletions(-)

Index: linux/dev/drivers/usb/input/hid-core.c
===================================================================
--- linux.orig/dev/drivers/usb/input/hid-core.c
+++ linux/dev/drivers/usb/input/hid-core.c
@@ -26,6 +26,7 @@
  #include <asm/byteorder.h>
  #include <linux/input.h>
  #include <linux/wait.h>
+#include <linux/rwsem.h>

  #include <linux/usb.h>

@@ -772,184 +773,196 @@ void usbhid_init_reports(struct hid_devi
  static const struct hid_blacklist {
  	__u16 idVendor;
  	__u16 idProduct;
+	__u16 idProductMask;
  	__u32 quirks;
-} hid_blacklist[] = {
