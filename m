I test hardware is ok. I test with this:
 {
        int fd, t;
        int i;
        char buf[512];
        fd =3D open("/dev/i2c-0", O_RDWR);
        printf("fd=3D%d\n",fd);
        t =3D ioctl(fd, I2C_SLAVE, 0x6c);
        printf("t=3D%d\n",t);
        memset(buf,0,512);
        t =3D read(fd,buf,512);
        printf("t=3D%d\n",t);
        for(i=3D0;i<t;i++) {
        printf("0x%x,",buf[i]);
        }
        printf("\n");
        exit(0);
}

