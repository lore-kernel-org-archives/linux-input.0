-		return retval;
-
-	if (profile < 1 || profile > 5)
-		return -EINVAL;
-
-	temp_buf.command = ARVO_COMMAND_ACTUAL_PROFILE;
-	temp_buf.actual_profile = profile;
-
-	mutex_lock(&arvo->arvo_lock);
