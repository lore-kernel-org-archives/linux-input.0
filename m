-	int retval;
-
-	retval = roccat_common2_receive(usb_dev, ARVO_COMMAND_ACTUAL_PROFILE,
-			&temp_buf, sizeof(struct arvo_actual_profile));
-
-	if (retval)
-		return retval;
-
-	return temp_buf.actual_profile;
